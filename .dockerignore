# ======================================
# PortalJS OpenMetadata Starter
# Docker Ignore File
# ======================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next
out
build
dist

# Environment files (should be passed at runtime)
.env
.env.*
!.env.example

# Development files
.git
.gitignore
.github

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker files (not needed in image)
Dockerfile*
docker-compose*.yml
docker-volume

# Documentation (optional - keep or remove based on needs)
*.md
!README.md

# Test files
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# Misc
*.log
*.pem
.vercel
restclient.http
