# =============================================================================
# OpenMetadata + PortalJS Full Stack - Environment Configuration
# =============================================================================
# Copy this file to .env and configure as needed.
#
# IMPORTANT: After first startup, run the setup script:
#   ./scripts/01_setup-sample-data.sh
# =============================================================================

# =============================================================================
# REQUIRED: OpenMetadata Connection
# =============================================================================

# OpenMetadata Instance URL
# - For local development (without Docker): http://localhost:8585
# - For Docker deployment: set automatically by docker-compose.yml
NEXT_PUBLIC_DMS=http://localhost:8585

# OpenMetadata Bot / Admin Token
# Created by the init script after first startup.
# Leave empty for initial deployment, then update after running init script.
DMS_TOKEN=

# =============================================================================
# OPTIONAL: Organization Filter
# =============================================================================
# Filter data products by organization/domain (leave empty to show all)
NEXT_PUBLIC_ORG=

# =============================================================================
# OPTIONAL: OpenMetadata Configuration (Docker only)
# =============================================================================
# These have sensible defaults, only change if needed.

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Admin credentials for Airflow
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# Heap size for OpenMetadata server (adjust based on available memory)
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
